default_platform(:ios)

# Fastlane instead of hand-rolled xcodebuild archive/export/upload calls —
# after many failed attempts pinning down undocumented Xcode 16 CLI export
# behavior (see PROJECT_LOG.md's "release.yml 反复失败排查" section),
# switched to the tool that's specifically built to absorb exactly these
# per-Xcode-version quirks instead of us rediscovering them one at a time.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
    )

    # api_key[:key_filepath] is only populated when the action is given
    # key_filepath as input — we pass key_content instead, so it comes back
    # empty (confirmed: "-authenticationKeyPath flag must be an absolute
    # path to an existing file" with an empty path in the previous run).
    # xcodebuild's own -authenticationKeyPath flag (used below) needs a real
    # file regardless, so write one ourselves.
    require "tmpdir"
    auth_key_path = File.join(Dir.mktmpdir, "AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
    File.write(auth_key_path, ENV["APPSTORE_PRIVATE_KEY"])

    # build_app has no api_key parameter (confirmed via the "invalid
    # parameters" error listing every option gym accepts — api_key isn't
    # among them). The CI debug step that dumps
    # ~/Library/MobileDevice/Provisioning Profiles/ showed "No such file or
    # directory" on every failed run — the two named App Store profiles
    # referenced below were never actually downloaded onto the runner, so
    # archiving fell back to an automatically-managed (non-App-Store)
    # signature, and exportArchive's IDEDistributionMethodManager then found
    # no valid app-store method for that archive. Fetch the two existing
    # profiles by name before archiving so manual signing has real local
    # files to sign with.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.shuyinlab.watchvoiceintake",
      provisioning_name: "WatchVoiceIntake AppStore",
      team_id: ENV["APPLE_TEAM_ID"],
      readonly: true,
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.shuyinlab.watchvoiceintake.watchkitapp",
      provisioning_name: "WatchVoiceIntakeWatch AppStore",
      team_id: ENV["APPLE_TEAM_ID"],
      readonly: true,
    )

    # With real signing now on (CODE_SIGNING_ALLOWED=YES, DEVELOPMENT_TEAM
    # set), the .app products inside the archive are genuinely signed
    # correctly (_CodeSignature, embedded.mobileprovision, dSYMs all
    # present — confirmed via a debug dump of Products/ and dSYMs/) — but
    # the archive's own top-level Info.plist is completely missing the
    # ApplicationProperties dict (only ArchiveVersion/CreationDate/
    # Name/SchemeName present). That dict is what IDEDistributionMethodManager
    # reads to know what product to offer distribution methods for; with it
    # missing, EVERY method gets rejected as "doesn't support distributing
    # archive" — not just app-store, confirmed via the verbose distribution
    # log. This is a known long-standing Xcode bug: `xcodebuild archive` run
    # from the command line (not through Xcode.app's GUI) frequently skips
    # writing ApplicationProperties, even for a correctly signed archive.
    # Documented community workaround: archive separately, patch the dict in
    # by hand using the values already sitting in the signed .app's own
    # Info.plist, then have gym skip its own archive step and just export
    # the patched archive.
    archive_path = File.join(Dir.mktmpdir, "WatchVoiceIntake.xcarchive")
    sh(
      "cd .. && xcodebuild -scheme WatchVoiceIntake -project WatchVoiceIntake.xcodeproj " \
      "-configuration Release -destination 'generic/platform=iOS' " \
      "-archivePath '#{archive_path}' " \
      "CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} " \
      "archive"
    )

    app_plist = File.join(archive_path, "Products/Applications/WatchVoiceIntake.app/Info.plist")
    bundle_id = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' '#{app_plist}'").strip
    short_version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' '#{app_plist}'").strip
    bundle_version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' '#{app_plist}'").strip

    archive_plist = File.join(archive_path, "Info.plist")
    sh("/usr/libexec/PlistBuddy -c 'Add :ApplicationProperties dict' '#{archive_plist}'")
    {
      "ApplicationPath" => "Applications/WatchVoiceIntake.app",
      "CFBundleIdentifier" => bundle_id,
      "CFBundleShortVersionString" => short_version,
      "CFBundleVersion" => bundle_version,
      "SigningIdentity" => "Apple Distribution",
      "Team" => ENV["APPLE_TEAM_ID"],
    }.each do |key, value|
      sh("/usr/libexec/PlistBuddy -c \"Add :ApplicationProperties:#{key} string #{value}\" '#{archive_plist}'")
    end

    # destination: upload (bypassing altool/pilot) also hit "Validation
    # failed n/a" — same opaque, detail-free STATE_ERROR.VALIDATION_ERROR
    # from Apple's Iris API, confirmed via ContentDelivery.log, even after
    # adding the missing AppIcon. Two independent upload code paths (altool
    # and ContentDelivery) both fail identically with zero diagnostic
    # detail, which points at Apple's backend rejecting something about the
    # actual package content rather than either tool. Switch back to a
    # plain export (no upload) so archive/export keeps succeeding reliably,
    # then separately run `xcrun altool --validate-app` — an older,
    # dedicated validation path that historically surfaces a specific
    # human-readable reason instead of just an opaque error ID.
    build_app(
      skip_build_archive: true,
      archive_path: archive_path,
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      export_options: {
        provisioningProfiles: {
          "com.shuyinlab.watchvoiceintake" => "WatchVoiceIntake AppStore",
          "com.shuyinlab.watchvoiceintake.watchkitapp" => "WatchVoiceIntakeWatch AppStore",
        }
      },
      export_xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{auth_key_path} -authenticationKeyID #{ENV['APPSTORE_KEY_ID']} -authenticationKeyIssuerID #{ENV['APPSTORE_ISSUER_ID']}"
    )

    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    sh(
      "xcrun altool --validate-app -f '#{ipa_path}' -t ios " \
      "--apiKey #{ENV['APPSTORE_KEY_ID']} --apiIssuer #{ENV['APPSTORE_ISSUER_ID']} " \
      "--output-format xml",
      log: true
    )
  end
end
