default_platform(:ios)

# Fastlane instead of hand-rolled xcodebuild archive/export/upload calls —
# after many failed attempts pinning down undocumented Xcode 16 CLI export
# behavior (see PROJECT_LOG.md's "release.yml 反复失败排查" section),
# switched to the tool that's specifically built to absorb exactly these
# per-Xcode-version quirks instead of us rediscovering them one at a time.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
    )

    # api_key[:key_filepath] is only populated when the action is given
    # key_filepath as input — we pass key_content instead, so it comes back
    # empty (confirmed: "-authenticationKeyPath flag must be an absolute
    # path to an existing file" with an empty path in the previous run).
    # xcodebuild's own -authenticationKeyPath flag (used below) needs a real
    # file regardless, so write one ourselves.
    require "tmpdir"
    auth_key_path = File.join(Dir.mktmpdir, "AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
    File.write(auth_key_path, ENV["APPSTORE_PRIVATE_KEY"])

    # build_app has no api_key parameter (confirmed via the "invalid
    # parameters" error listing every option gym accepts — api_key isn't
    # among them). The CI debug step that dumps
    # ~/Library/MobileDevice/Provisioning Profiles/ showed "No such file or
    # directory" on every failed run — the two named App Store profiles
    # referenced below were never actually downloaded onto the runner, so
    # archiving fell back to an automatically-managed (non-App-Store)
    # signature, and exportArchive's IDEDistributionMethodManager then found
    # no valid app-store method for that archive. Fetch the two existing
    # profiles by name before archiving so manual signing has real local
    # files to sign with.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.shuyinlab.watchvoiceintake",
      provisioning_name: "WatchVoiceIntake AppStore",
      team_id: ENV["APPLE_TEAM_ID"],
      readonly: true,
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.shuyinlab.watchvoiceintake.watchkitapp",
      provisioning_name: "WatchVoiceIntakeWatch AppStore",
      team_id: ENV["APPLE_TEAM_ID"],
      readonly: true,
    )

    # Profiles are now confirmed present locally (SIGH_PROFILE_PATH points at
    # real files) and Archive still succeeds, but exportArchive still hits
    # the identical "Unknown Distribution Error" / "expected one {} but
    # found app-store" — so it's neither a missing-profile nor an
    # account/team problem. gym's build_app has no api_key parameter and
    # does NOT forward ASC API key auth into the underlying `xcodebuild
    # -exportArchive` subprocess on its own (unlike upload_to_testflight,
    # which does its own auth). That subprocess is the one asking Apple's
    # servers which distribution methods are valid, and it's running with
    # zero Apple credentials of any kind — no signed-in Xcode account, no
    # key. Passing xcodebuild's own `-authenticationKeyPath/-ID/-IssuerID`
    # flags via export_xcargs is the documented way to authenticate that
    # specific subprocess.
    build_app(
      project: "WatchVoiceIntake.xcodeproj",
      scheme: "WatchVoiceIntake",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      # project.yml's global settings block hard-codes CODE_SIGNING_ALLOWED:
      # NO (intentionally, for the unsigned "compiles only" build.yml check)
      # with a comment saying release.yml was supposed to override it back
      # to YES — that override was never actually wired up anywhere. With
      # signing disabled at the project level, every past archive "succeeded"
      # without ever really signing anything, regardless of how correct the
      # team/cert/profile/auth setup was, which is why every previous fix
      # attempt here changed nothing. Override it for this archive only.
      # Actually enabling signing surfaced the next real, standard Xcode
      # error: "requires a development team" — project.yml sets
      # CODE_SIGN_IDENTITY/PROVISIONING_PROFILE_SPECIFIER per target but
      # never DEVELOPMENT_TEAM, and export_team_id only affects the export
      # step, not archiving.
      xcargs: "CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
      export_options: {
        provisioningProfiles: {
          "com.shuyinlab.watchvoiceintake" => "WatchVoiceIntake AppStore",
          "com.shuyinlab.watchvoiceintake.watchkitapp" => "WatchVoiceIntakeWatch AppStore",
        }
      },
      export_xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{auth_key_path} -authenticationKeyID #{ENV['APPSTORE_KEY_ID']} -authenticationKeyIssuerID #{ENV['APPSTORE_ISSUER_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
